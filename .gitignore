# ===================================================================
# Hospitality Platform - Comprehensive .gitignore
# ===================================================================

# Compiled Java & Maven build outputs
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Node.js & Frontend dependencies & build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Sensitive Configuration Files (Secrets, Credentials, Passwords)
.env
.env.*
!.env.example
*.env
application-local.properties
application-secret.properties
application-dev.properties
**/application-local.properties
**/application-secret.properties
**/application-dev.properties
!**/application-example.properties

# Logs and runtime diagnostics
logs/
**/logs/
*.log
*.log.*
nohup.out

# IDE and Editor configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.factorypath

# OS and Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*~

# Temporary test scripts
verify_system.ps1
