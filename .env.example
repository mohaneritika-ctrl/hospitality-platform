# ===================================================================
# Hospitality Platform - Example Environment Variables (.env.example)
# Copy this file to .env for local configuration.
# DO NOT commit real secrets or database passwords to GitHub.
# ===================================================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospitality_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server Configuration
SERVER_PORT=8080

# JWT Security
JWT_SECRET=your_256_bit_jwt_secret_key_here
JWT_EXPIRATION=86400000

# AI Chatbot (Optional - if omitted, smart fallback engine is used)
AI_API_KEY=your_gemini_api_key_here
AI_GEMINI_MODEL=gemini-1.5-flash
